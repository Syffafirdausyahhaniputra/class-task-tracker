              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tasks?search=&status=&page=1&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Cari pada judul tugas."
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "Kosong, done, atau pending. Filter ini berlaku untuk siswa."
